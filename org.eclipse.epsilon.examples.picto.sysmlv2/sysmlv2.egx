import "util.eol";

rule States2Graphviz
    transform su : StateUsage {

    guard: su.getSubstates().notEmpty()
	
    template : "stateusage.egl"
	
    parameters : Map{
        "path" = Sequence{"States", su.name},
        "format" = "puml",
        "layers" = Sequence {
            Map {"id"="notes", "title"="Notes", "active"=true}
        }
    }

}

rule Model2TreeMap {
	template : "masstreemap.egl"
	
	parameters : Map{
		"path" = Sequence{"Mass tree-map"},
		"format" = "html",
		"layers" = Sequence {
			Map {"id"="notes", "title"="Notes", "active"=true}
		}
	}
}
